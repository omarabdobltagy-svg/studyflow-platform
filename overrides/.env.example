# Required application settings
NODE_ENV=production
PORT=8080
DATABASE_URL=
JWT_SECRET=

# Google Sign-In (OAuth 2.0 Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in Google Cloud Console.
# Production example: https://studyflow-app-production.up.railway.app/api/oauth/google/callback
GOOGLE_REDIRECT_URI=

# Legacy Manus OAuth settings are retained only for existing scheduled integrations, if used.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
